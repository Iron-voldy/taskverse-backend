# Server
PORT=3001
NODE_ENV=production

# Database
MONGODB_URI=mongodb://localhost:27017/taskverse

# Redis (for future queue/cache use)
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 32
JWT_SECRET=<run: openssl rand -base64 32>

# Google OAuth — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=<from Google Cloud Console>

# Gemini AI — from aistudio.google.com
GEMINI_API_KEY=<from Google AI Studio>

# CORS — set to your frontend domain in production
FRONTEND_URL=https://taskverse.app

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=<Gmail App Password>
